# Copy this file to backend/.env — it's loaded automatically on startup
# (via python-dotenv, see backend/config/settings.py), so no manual
# `export` step is needed.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1, localhost


# SMTP config for admin OTP login emails. Without these, OTP codes are just
# printed to the Django console — fine for local dev, NOT fine in production.
DJANGO_EMAIL_HOST=smtp.gmail.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=seyontouch@gmail.com
DJANGO_EMAIL_HOST_PASSWORD=alas aaho lvjw ocbj
DJANGO_EMAIL_USE_TLS=1
DJANGO_DEFAULT_FROM_EMAIL=Seyon Touch <seyontouch@gmail.com>

# Razorpay payment gateway. Get these from your Razorpay Dashboard under
# Settings -> API Keys (use the Test Mode keys while developing). Checkout
# opens Razorpay's payment modal (UPI, cards, netbanking, wallets) and
# payments are verified automatically, server-side.
RAZORPAY_KEY_ID=rzp_live_TPaHUtOwVsHzFm
